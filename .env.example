# Salin menjadi .env HANYA jika perlu. File .env sudah ada di .gitignore, jadi tidak ikut ke GitHub.

PORT=3000

# OPSIONAL. Cara yang disarankan: kosongkan dua baris ini, buka /admin/ dan buat akun
# lewat kode setup yang tampil di terminal. Password disimpan sebagai hash di data/admin.json.
# Isi hanya jika hosting-mu punya fitur "Environment Variables / Secrets" (Railway, Render, dll.)
# dan kamu ingin akun diatur dari sana. Jika diisi, nilai ini yang dipakai.
ADMIN_USER=
ADMIN_PASSWORD=

# OPSIONAL. Jika kosong, dibuat otomatis dan disimpan di data/admin.json.
SESSION_SECRET=
