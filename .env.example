# Salin file ini menjadi .env lalu isi nilainya.

PORT=3000

# Login panel admin (/admin/). WAJIB diganti sebelum online.
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-password-ini

# Rahasia untuk menandatangani sesi admin (string acak panjang).
# Jika kosong, dibuat acak setiap server restart (admin harus login ulang).
SESSION_SECRET=

# Midtrans — ambil di dashboard.midtrans.com > Settings > Access Keys
# Kosongkan SERVER_KEY untuk MODE DEMO (pembayaran simulasi, tanpa Midtrans).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# false = Sandbox (uji coba), true = Production (uang sungguhan)
MIDTRANS_IS_PRODUCTION=false
