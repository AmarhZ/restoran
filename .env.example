# Salin file ini menjadi .env lalu isi nilainya.

PORT=3000

# Login panel admin (/admin/). WAJIB diganti sebelum online.
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-password-ini

# Rahasia untuk menandatangani sesi admin (string acak panjang).
# Jika kosong, dibuat acak setiap server restart (admin harus login ulang).
SESSION_SECRET=

# Pembayaran memakai QRIS statis milik restoran.
# Gambar QRIS diunggah lewat Admin > Pengaturan > Pembayaran QRIS (bukan di file ini).
